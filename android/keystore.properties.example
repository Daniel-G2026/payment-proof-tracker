# Release signing for the Play Store. Copy this file to `keystore.properties`
# (same directory) and fill in real values. The real file is gitignored — NEVER
# commit it or the .jks/.keystore it points to.
#
# 1. Generate an upload keystore (do this ONCE, then back it up somewhere safe —
#    losing it means you can't ship updates under the same Play listing):
#
#      keytool -genkeypair -v \
#        -keystore proofledger-upload.jks \
#        -alias proofledger \
#        -keyalg RSA -keysize 2048 -validity 10000
#
#    Keep proofledger-upload.jks OUT of the repo (e.g. android/keystore/ which is
#    gitignored via *.jks, or anywhere off-repo) and remember the two passwords
#    you set.
#
# 2. Point these values at it. RELEASE_STORE_FILE is resolved relative to the
#    android/ project dir.
#
# 3. Build a publishable bundle:  ./gradlew :app:bundleRelease
#    (CI can supply these same names as environment variables instead of a file.)

RELEASE_STORE_FILE=keystore/proofledger-upload.jks
RELEASE_STORE_PASSWORD=changeme
RELEASE_KEY_ALIAS=proofledger
RELEASE_KEY_PASSWORD=changeme
