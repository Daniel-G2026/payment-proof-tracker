DATABASE_URL=postgresql+psycopg://proofledger:proofledger_dev@localhost:5432/proofledger
REDIS_URL=redis://localhost:6379/0
ENVIRONMENT=development

# Supabase Auth (Phase 2)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=replace-with-jwt-secret-from-supabase-project-settings-api
SUPABASE_ANON_KEY=replace-with-anon-public-key

# Phase 5 proof backup storage
PROOF_STORAGE_BACKEND=local
PROOF_STORAGE_LOCAL_DIR=storage/proofs
PROOF_STORAGE_PUBLIC_BASE_URL=
PROOF_STORAGE_S3_ENDPOINT_URL=
PROOF_STORAGE_S3_BUCKET=
PROOF_STORAGE_S3_REGION=
PROOF_STORAGE_S3_ACCESS_KEY=
PROOF_STORAGE_S3_SECRET_KEY=
PROOF_SIGNED_URL_SECRET=
PROOF_SIGNED_URL_EXPIRY_SECONDS=900

# Phase 8 — server-side OCR/AI extraction via Anthropic Claude.
# Get your key from https://console.anthropic.com/.
# Leave EXTRACTION_ENABLED unset (defaults true) or set to "false" to disable
# the whole pipeline — uploads still succeed, drafts just won't be created.
ANTHROPIC_API_KEY=
EXTRACTION_ENABLED=true
EXTRACTION_MODEL=claude-haiku-4-5-20251001
# Per-user enqueue caps. Uploads over the limit still succeed; extraction is
# silently skipped for the over-budget request.
EXTRACTION_RATE_PER_HOUR=30
EXTRACTION_RATE_PER_MINUTE=5
# Days to keep the raw vision model response on transaction_drafts.raw_json
# before a daily cron nulls it out. Cleaned per-field values stay forever.
EXTRACTION_RAW_RETENTION_DAYS=30

# Phase 12 — observability, hardening, and deployment.
# Structured logging. LOG_JSON=true emits one JSON object per line (prod);
# set false for readable text locally.
LOG_LEVEL=INFO
LOG_JSON=true
# Error reporting. Leave SENTRY_DSN empty to disable (dev/test never report).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
# CORS for a future web dashboard. Comma-separated origins; empty = disabled.
# NEVER use "*" in production — list only the dashboard origin(s).
CORS_ALLOW_ORIGINS=
# Per-user HTTP rate limiting (Redis-backed, fails open if Redis is down).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_UPLOAD_PER_MINUTE=20
